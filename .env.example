# Copy to .env.local for local dev, and set in your hosting provider's env for production.
# Used by app/api/contact to deliver the consultation form via Resend.
# Same values as the portal (domain jagdeepkaur.legal is already verified in Resend).

EMAIL_PROVIDER_KEY=      # Resend API key (re_...)
EMAIL_FROM=noreply@jagdeepkaur.legal   # any address on the verified domain
# CONTACT_TO=            # optional: override recipient (defaults to siteConfig.email)
